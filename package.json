{
  "name": "@openpowershift/prot-setpoint-language",
  "version": "0.1.0",
  "description": "Protection Setting Diagram Language (PSDL). A small text language for protection-relay setting selection diagrams, rendered to SVG/PNG/PDF with a live browser playground.",
  "keywords": [
    "psdl",
    "protection-settings",
    "protection",
    "setpoint",
    "diagram",
    "svg",
    "relay",
    "grading",
    "engineering",
    "openpowershift"
  ],
  "license": "MIT",
  "author": "Daniel Mulholland",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPowerShift/prot-setpoint-language.git"
  },
  "homepage": "https://github.com/OpenPowerShift/prot-setpoint-language",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "psdl": "./lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/components/*",
    "**/main.ts",
    "**/*.css"
  ],
  "files": [
    "lib",
    "spec",
    "examples",
    "README.adoc",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build:lib",
    "postpublish": "echo done"
  },
  "dependencies": {
    "@codemirror/search": "^6.7.1",
    "@resvg/resvg-js": "^2.6.0",
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.6.0"
  },
  "devDependencies": {
    "@asciidoctor/core": "^4.0.8",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "codemirror": "^6.0.0",
    "eslint": "^9.0.0",
    "lit": "^3.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "optionalDependencies": {
    "jsdom": "^29.1.1"
  }
}
